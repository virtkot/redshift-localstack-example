# Example only — not production-ready or officially supported. See README.md.
#
# Copy to .env and `source .env` (or export individually) before running
# terraform / the provisioning scripts / pytest.
#
# This file is the ONLY place anything LocalStack-specific lives. Every
# .tf/.py file in this repo is identical to what you'd run against real AWS;
# swapping this file for real AWS credentials (and dropping the
# AWS_ENDPOINT_URL* lines) is the only change needed to point at real AWS.

# Required so LocalStack Pro is used (Redshift Data API is a Pro-only feature).
LOCALSTACK_AUTH_TOKEN=

# LocalStack is deployed via the Helm chart (see k8s/values.yaml) with its
# default service.type=NodePort, exposing the edge port on node port 31566
# rather than the usual 4566. Some local Kubernetes distros (e.g. Rancher
# Desktop, Docker Desktop) auto-forward NodePort services to localhost on
# that same port; otherwise use `kubectl port-forward` (see README.md).

# Virtual-hosted-style S3 endpoint. Using the s3.localhost.localstack.cloud
# hostname (rather than path-style addressing) means this is the same kind of
# value real AWS would use, just a different host.
AWS_ENDPOINT_URL_S3=http://s3.localhost.localstack.cloud:31566

# Covers redshift + redshift-data (and anything else) via boto3's/Terraform's
# generic endpoint override.
AWS_ENDPOINT_URL=http://localhost:31566

AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1
